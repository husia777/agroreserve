# ============================================================
# Переменные окружения — Агрорезерв Backend
# Скопируй в .env и заполни реальными значениями
# НЕ КОММИТЬ .env в git!
# ============================================================

# ── Приложение ────────────────────────────────────────────────
APP_NAME="Агрорезерв"
APP_VERSION="1.0.0"
DEBUG=false
# Домены для CORS (через запятую)
CORS_ORIGINS="https://agroreserve.ru,https://agroreserve.ru,http://localhost:3000,http://localhost:5173"

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI="mongodb://admin:supersecret@localhost:27017/agroreserve?authSource=admin"
MONGODB_DB_NAME="agroreserve"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URI="redis://:redispass@localhost:6379/0"
REDIS_PASSWORD="redispass"

# ── JWT Аутентификация ────────────────────────────────────────
# Генерация: openssl rand -hex 32
JWT_SECRET_KEY="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
# Время жизни access токена в минутах
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Время жизни refresh токена в днях
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── 1С:Предприятие OData API ─────────────────────────────────
ODATA_1C_URL="http://your-1c-server/1c/hs/odata/standard.odata/"
ODATA_1C_LOGIN="api_user"
ODATA_1C_PASSWORD="api_password"
# Интервал синхронизации остатков (в минутах)
SYNC_1C_INTERVAL_MINUTES=5
# API-ключ для входящих запросов из 1С (X-API-Key заголовок)
# Генерация: openssl rand -hex 32
SYNC_1C_API_KEY="your-1c-sync-api-key-change-in-production"

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="1234567890:ABCDefghijklmnopqrstuvwxyz"
TELEGRAM_ADMIN_CHAT_ID="123456789"
# Токен для верификации Telegram webhook
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT=465
SMTP_USER="naimoffh@yandex.ru"
SMTP_PASSWORD="lrzknvmbbdyebhew"
SMTP_FROM_NAME="Агрорезерв"
SMTP_FROM_EMAIL="naimoffh@yandex.ru"
SMTP_USE_TLS=true

# ── S3 / Яндекс.Облако Object Storage ────────────────────────
S3_ENDPOINT_URL="https://storage.yandexcloud.net"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="agroreserve"
S3_REGION="ru-central1"
# Префикс публичного URL для файлов
S3_PUBLIC_URL="https://storage.yandexcloud.net/agroreserve"

# ── Rate Limiting ─────────────────────────────────────────────
# Максимум запросов в минуту
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_ADMIN_PER_MINUTE=1000

# ── Загрузка файлов ───────────────────────────────────────────
# Максимальный размер файла в байтах (10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
# Разрешённые типы файлов
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
ALLOWED_DOC_TYPES="application/pdf,image/jpeg,image/png"

# ── Бизнес настройки ─────────────────────────────────────────
# НДС — ИП на УСН 6% не является плательщиком НДС
TAX_RATE_PERCENT=6
# Дней до предупреждения о скором истечении сертификата
CERTIFICATE_EXPIRY_WARNING_DAYS=30
# Дней просрочки дебиторки до уведомления
DEBT_OVERDUE_WARNING_DAYS=30
# Дней просрочки до автоблокировки клиента
DEBT_OVERDUE_BLOCK_DAYS=60

# ── Mongo Docker (используется в docker-compose.yml) ─────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=supersecret

# ── Telegram Bot (UC-47) ──────────────────────────────────
TELEGRAM_BOT_TOKEN="8629377110:AAFyGzF8OJX3wi-jGmT1FId8a-7FSebYXzU"
TELEGRAM_ADMIN_CHAT_ID="5528626787"
TELEGRAM_WEBHOOK_SECRET=""
